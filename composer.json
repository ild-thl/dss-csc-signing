{
    "name": "isy-thl/dss-csc-signing",
    "description": "Framework-independent DSS and CSC JAdES signing integration",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-openssl": "*"
